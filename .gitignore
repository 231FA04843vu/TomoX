# Monorepo ignores
**/node_modules/
**/dist/
**/dist-ssr/
**/.vite/
**/.cache/
**/coverage/

# Environment & secrets
**/.env
**/.env.local
**/.env.*.local
**/.env.production
**/.env.production.local

# Logs
**/logs/
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# OS / editor
**/.DS_Store
**/.idea/
**/.vscode/

# Temporary files
**/*.tmp
**/*.bak
**/*~
**/*.swp
**/*.swo